n request_records\n            }\n            completed = next(\n                record for record in request_records if record[\"event\"] == \"request_completed\"\n            )\n            assert completed[\"http_method\"] == \"GET\"\n            assert completed[\"http_path\"] == \"/api/v1/pet/findByStatus\"\n            assert completed[\"http_status_code\"] == 200\n            assert completed[\"duration_ms\"] >= 0\n            assert completed[\"service\"] == \"petstore-api\"\n            assert completed[\"app_env\"] == \"prod\"\n>           assert \"timestamp\" in completed\nE           AssertionError: assert 'timestamp' in {'app_env': 'prod', 'client_ip': 'testclient', 'correlation_id': 'rich-log-test', 'duration_ms': 1.76, ...}\n\ntests/unit/test_app_factory.py:164: AssertionError","start":1786653936644,"stop":1786653936677,"duration":33,"labels":[{"name":"layer","value":"unit"},{"name":"severity","value":"critical"},{"name":"story","value":"Request Logging"},{"name":"feature","value":"App Factory"},{"name":"epic","value":"Application"},{"name":"parentSuite","value":"tests.unit"},{"name":"suite","value":"test_app_factory"},{"name":"host","value":"runnervmvrwv9"},{"name":"thread","value":"2331-MainThread"},{"name":"framework","value":"pytest"},{"name":"language","value":"cpython3"},{"name":"package","value":"tests.unit.test_app_factory"},{"name":"owner","value":"Ramon Alcantara Arceo"}],"url":"","historyId":"22804dcae67e4ca60ebe63f3acb1f4dc.d41d8cd98f00b204e9800998ecf8427e","reportLinks":[]}],"retries":[],"breadcrumbs":[["tests.unit","test_app_factory"]],"retry":false,"titlePath":["tests","unit","test_app_factory.py"],"retriesCount":0,"attachments":[],"order":74,"categories":[]}