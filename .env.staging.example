# Copy to .env.staging and set real credentials

DATABASE_POOLER_URL=postgresql://postgres.REPLACE_WITH_YOUR_PROJECT_REF:REPLACE_WITH_DB_PASSWORD@aws-1-us-east-2.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres:REPLACE_WITH_DB_PASSWORD@db.REPLACE_WITH_YOUR_PROJECT_REF.supabase.co:5432/postgres
API_KEY=dev-api-key

SUPABASE_JWT_SECRET=REPLACE_WITH_YOUR_SUPABASE_JWT_SECRET

# Never seed a real database on startup
SEED_DATASET=

SUPABASE_URL=https://REPLACE_WITH_YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_YOUR_SUPABASE_PUBLISHABLE_KEY
# Backward-compatible alias:
# SUPABASE_ANON_KEY=REPLACE_WITH_YOUR_SUPABASE_ANON_KEY
# Preferred: scoped Supabase Secret API key for admin auth operations.
SUPABASE_SECRET_API_KEY=REPLACE_WITH_YOUR_SUPABASE_SECRET_API_KEY
# Backward-compatible alias (legacy, broader privilege):
# SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_YOUR_SUPABASE_SERVICE_ROLE_KEY
